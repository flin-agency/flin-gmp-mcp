# Set these in the MCP client environment. This server does not load .env automatically.
GOOGLE_CLIENT_ID=your-desktop-app-client-id
GOOGLE_CLIENT_SECRET=your-desktop-app-client-secret
# Optional: enable only products you use (default: all four).
GOOGLE_GMP_SERVICES=admin,dv360,cm360,sa360
# GOOGLE_GMP_TOKEN_DIR=/absolute/path/to/private/gmp-tokens
# GOOGLE_GMP_OAUTH_PORT=0
# GOOGLE_GMP_QUOTA_PROJECT=your-google-cloud-project-id
